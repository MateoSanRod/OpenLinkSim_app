{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Current File (Python)",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Run Main (__main__.py)",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/CDIM_app/__main__.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}"
        }
    ]
}
