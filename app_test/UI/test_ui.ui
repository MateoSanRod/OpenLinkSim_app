           <property name="styleSheet">
            <string notr="true">QPlainTextEdit {
    background-color: #303030; /* Dark background */
    color: #ffffff; /* White text color */
    border: 1px solid #303030; /* Dark border */
    padding: 0px; /* Remove default padding */
    font-size: 12px; /* Font size */
    groove: none; /* Remove the groove */
    font-family: Consolas, monospace; /* Font family */
}

QPlainTextEdit QScrollBar {
		background: #303030;
		border: none;
		margin: 0;
		padding: 0;
		width: 10px;
		groove: rgb(96, 33, 255)
	}
	
QPlainTextEdit QScrollBar:handle {
		border: none;
		background: #414141;
}

QPlainTextEdit QScrollBar::add-line:vertical, QPlainTextEdit QScrollBar::sub-line:vertical {
    background: none; /* No background for scrollbar buttons */
}
QPlainTextEdit QScrollBar::up-arrow:vertical, QPlainTextEdit QScrollBar::down-arrow:vertical{
	background: none;
}
QPlainTextEdit QScrollBar::add-page:vertical, QPlainTextEdit QScrollBar::sub-page:vertical{
	background: none;
}

QPlainTextEdit {
    selection-color: #ffffff; /* Change selection text color */
    selection-background-color: rgb(153, 153, 153); /* Change selection background color */
}</string>
